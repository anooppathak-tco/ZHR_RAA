<core:FragmentDefinition
	xmlns="sap.m"
	xmlns:core="sap.ui.core"
	xmlns:custom="http://schemas.sap.com/sapui5/extension/sap.ui.core.CustomData/1"
	xmlns:l="sap.ui.layout">
	<Dialog
		id="initAwardTypeDialog"
		class="sapUiContentPadding"
		contentHeight="70%"
		contentWidth="70%"
		title="{i18n>type}">
		<VBox items="{mModel>/AwardSet}">
			<l:Grid defaultSpan="XL6 L6 M12 S12" hSpacing="2">
				<VBox>
					<RadioButton
						text="{mModel>AwText}"
						select=".onInitAwardSelect"/>
				</VBox>
				<VBox >
					<Text 
						text="{mModel>LevLongText}" 
						class="fontBold"/>
				</VBox>
			</l:Grid>
		</VBox>
		<beginButton>
			<Button id="idInitAwardTypeBtnSbmt" text="{i18n>submit}" 
			visible="false" press=".onInitAwardTypeHelpSubmit"/>
		</beginButton>
	</Dialog>
</core:FragmentDefinition>