<core:FragmentDefinition
	xmlns="sap.m"
	xmlns:core="sap.ui.core"
	xmlns:custom="http://schemas.sap.com/sapui5/extension/sap.ui.core.CustomData/1"
	xmlns:l="sap.ui.layout"
	xmlns:upload="sap.m.upload">
	<Dialog
		id="awardTypeDialog"
		class="sapUiContentPadding"
		contentHeight="70%"
		contentWidth="70%"
		title="{i18n>type}"
		beforeOpen="onBeforeAwardTypeDialogOpen"
		afterOpen="onAfterAwardTypeDialogOpen">
		<VBox items="{mModel>/AwardSet}">
			<l:Grid defaultSpan="XL3 L3 M6 S12">
				<VBox>
					<RadioButton
						select=".onAwardSelect"
						text="{mModel>AwText}"/>
				</VBox>
				<VBox >
					<RadioButtonGroup
						buttons="{path: 'mModel>LevelSet/results', templateShareable: true}"
						enabled="false">
						<RadioButton 
							select=".onAwardSelect"
							text="{parts: ['mModel>/form/typeAward', 'mModel>LevText', 'mModel>MinValue', 'mModel>MaxValue'], formatter: '.awardTypeTextFormatter'}"/>
					</RadioButtonGroup>
				
				</VBox>
				<VBox width="200%" >
					<MessageStrip class="sapUiResponsiveMargin" visible="false"
					type="Warning" text="{i18n>noCertificate}" showIcon="true">
					</MessageStrip>
				</VBox>
				<VBox >
					<Text 
						text="{mModel>LevLongText}" 
						class="fontBold"/>
				</VBox>
			</l:Grid>
		</VBox>
		<VBox class="sapUiSmallMarginTop">
			<Label 
				visible="{= ${mModel>/form/typeAward} === 'C'}"
				labelFor="inpAmount" 
				text="{i18n>awardAmount} (1 {i18n>mci} = {path: 'mModel>/MciSet/Betrg', formatter: '.formatterSpacesAndKZT'})"/>
			<Label 
				visible="{= ${mModel>/form/typeAward} === 'N'}"
				labelFor="inpAmount" 
				text="{i18n>awardAmountNC}"/>
			<Input id="inpAmount" enabled="false" liveChange=".inpAmountLiveChange"/>
			<Text id="inpAmountCurrency" class="sapUiTinyMarginTop" visible="{= ${mModel>/form/typeAward} === 'C'}"/>
		</VBox>
		<FormattedText
			id="idFormattedText"
			class="sapUiSmallMargin"
			htmlText="{i18n>justificationInfo}"
			visible="false"
			/>
		<VBox id="indResaon" class="sapUiSmallMarginTop"
			visible="false">
			<Label labelFor="inpIndividualReason" text="{i18n>individualReason}"/>
			<TextArea id="inpIndividualReason" maxLength="1000" width="100%" rows="5"/>
		</VBox>
		<!-- Date Input -->
        <VBox id="awardDateInp" class="sapUiSmallMarginTop"
			visible="false">
            <Label text="{i18n>AwardDate}" labelFor="dateInput"/>
            <DatePicker id="dateInput" width="100%" valueFormat="yyyy-MM-dd" displayFormat="long"
			minDate="{dateModelAward>/minDate}"
			maxDate="{dateModelAward>/maxDate}"/>
        </VBox>
		<VBox id="uploadsetBox" class="sapUiSmallMarginTop" visible="false">	
		
		<upload:UploadSet
			id="UploadSet"
			instantUpload="false" 
			items="{path: 'fileModel>/files', templateShareable: false}"
			maxFileSize="10" 
			uploadUrl="/sap/opu/odata/sap/ZESS023_RNA_SRV/AttachmentSet"
			afterItemAdded="onItemAdded"
			beforeUploadStarts="onBeforeUploadStarts"
			uploadCompleted="onUploadComplete"
			terminationEnabled="true"
			beforeItemEdited="onFileChange"
			beforeItemRemoved="onItemRemoved">				
			<upload:items>
				<upload:UploadSetItem
						fileName="{fileModel>fileName}"
						mediaType="{fileModel>mediaType}"
						url="{fileModel>url}">
				</upload:UploadSetItem>
			</upload:items>
		</upload:UploadSet>
		</VBox>
		<beginButton>
			<Button id="idAwardTypeBtnSbmt" text="{i18n>submit}" press=".onAwardTypeHelpSubmit"/>
		</beginButton>
		<endButton>
			<Button text="{i18n>close}" press=".onAwardTypeHelpClose"/>
		</endButton>
	</Dialog>
</core:FragmentDefinition>